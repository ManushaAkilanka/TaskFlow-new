<resources>
    <!-- Common Button Style -->
    <style name="TaskFlowButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">256dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/accent_purple</item>
        <item name="shapeAppearanceOverlay">@style/TaskFlowShapeSmall</item>
    </style>

    <!-- Red Button Style (Sign out/Delete) -->
    <style name="TaskFlowButtonRed" parent="TaskFlowButton">
        <item name="backgroundTint">@color/delete_red</item>
    </style>

    <!-- Dark Purple Button Style (Edit Info) -->
    <style name="TaskFlowButtonDark" parent="TaskFlowButton">
        <item name="backgroundTint">@color/edit_info_bg</item>
    </style>

    <!-- Common Input Style -->
    <style name="TaskFlowEditText">
        <item name="android:layout_width">300dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@color/input_bg</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <style name="TaskFlowShapeSmall" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>